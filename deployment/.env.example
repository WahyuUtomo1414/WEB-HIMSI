# Deployment target
DEPLOY_PATH=/home/username/public_html/web-himsi
DEPLOY_BRANCH=main

# SSH connection
SSH_HOST=example.com
SSH_PORT=22
SSH_USER=username

# Use literal \n for line breaks, then run deployment/sync.sh.
SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END OPENSSH PRIVATE KEY-----'
